# 本地 Docker 部署配置模板。
# 用法：cp docker.env.example .env   然后把 POSTGRES_PASSWORD 换成你自己的随机值。
# （.env 已在 .gitignore 中，不会被提交。）
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest

# 本地 PostgreSQL 密码：必填，docker-compose.yml 用 :? 强制校验。
# 生成一个：openssl rand -hex 16
POSTGRES_USER=artex
POSTGRES_PASSWORD=
POSTGRES_DB=artex

# LLM：留空则启动后在 UI 的「LLM 配置」页填写。
# 如需环境变量注入，取消注释并填值（ANTHROPIC / OPENAI 二选一或都填）。
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ARTEX_LLM_PROVIDER=
# ARTEX_LLM_MODEL=
# ARTEX_LLM_BASE_URL=
# ARTEX_LLM_PROXY=
